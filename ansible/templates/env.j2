# Database Configuration
DB_DSN=systrack:{{ systrack_db_password }}@tcp(localhost:3306)/systrack?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# Authentication
JWT_SECRET={{ jwt_secret | default('change_this_secret_key_for_production_use') }}
ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ admin_password }}

# Server Configuration
BIND_ADDRESS=0.0.0.0
PORT={{ systrack_port }}

# Monitoring Configuration
PING_ENGINE=auto
BATCH_SIZE=256
PACING_MS=5
TIMEOUT_MS=1000
RETRY=0
BATCH_INTERVAL_SEC=30
FAIL_OPEN=3
SUCCESS_CLOSE=2

# Data Retention
RAW_RETENTION_HOURS=48

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
