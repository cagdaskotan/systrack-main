[Unit]
Description=SysTrack (Beyz System) — Network Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/systrack
EnvironmentFile=/opt/systrack/.env
ExecStart=/opt/systrack/systrack
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=systrack

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/systrack

[Install]
WantedBy=multi-user.target
