# Database Configuration
DB_DSN=root:password@tcp(localhost:3306)/systrack?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# Authentication
JWT_SECRET=change_this_secret_key_for_production_use
ADMIN_EMAIL=admin@systrack.local
ADMIN_PASSWORD=ChangeMeNow!

# Server Configuration
BIND_ADDRESS=0.0.0.0
PORT=8080

# Monitoring Configuration
PING_ENGINE=auto
PING_BATCH_SIZE=256
PING_PACING_MS=5
PING_TIMEOUT_MS=5000
PING_RETRY=0
PING_BATCH_INTERVAL_SEC=30
FAIL_OPEN=3
SUCCESS_CLOSE=2

# Data Retention
RAW_RETENTION_HOURS=48

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Tehdit İstihbaratı (Crack / Lisans Uyumluluk Taraması)
# MalwareBazaar API key: https://auth.abuse.ch/
MALWAREBAZAAR_KEY=
# AlienVault OTX API key: https://otx.alienvault.com → Settings
OTX_API_KEY=
# VirusTotal API key (ücretsiz, 4 istek/dk): https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Management Sunucusu
MANAGEMENT_SERVER_URL=http://37.148.202.211:18080

# Ortam Sensörü (ESP32 / MQTT) — opsiyonel
# Sensör serisi management panelinden otomatik alınır; buraya yazmaya gerek yok.
# Boş bırakılırsa sensör servisi çalışmaz.
MQTT_BROKER_URL=ws://mqtt.systrack.app:9001
